# Configuración del Kernel para JuliOS
# Opciones optimizadas para sistema embebido con IA

#
# Configuración básica
#
CONFIG_LOCALVERSION="-julios"
CONFIG_LOCALVERSION_AUTO=y

#
# Arquitectura
#
CONFIG_X86_64=y
CONFIG_64BIT=y

#
# Básica
#
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_GZIP=y

#
# Sistemas de archivos (mínimo)
#
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_INITRAMFS_SOURCE=""

#
# Redes
#
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NET=y
CONFIG_NETDEVICES=y

#
# Drivers
#
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

#
# IA / Dispositivo personalizado
#
CONFIG_IAOS=y
CONFIG_IAOS_DEBUG=y
CONFIG_IAOS_BUFFER_SIZE=4096

#
# Seguridad
#
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_DEFAULT_SECURITY_DAC=y

#
# Memoria
#
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_SLAB=y
# CONFIG_SLUB no está configurado

#
# Debug (opcional)
#
# CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_INFO=y
# CONFIG_PRINTK=y

#
# Perf / Trace
#
CONFIG_PROFILING=y

#
# CPU
#
CONFIG_NR_CPUS=4
CONFIG_SCHED_SMT=y

#
# RCU
#
CONFIG_TREE_RCU=y
CONFIG_RCU_EXPERT=y