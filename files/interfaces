# Configuración de red para JuliOS
# Este archivo se copia a /etc/network/interfaces en el rootfs

# Loopback
auto lo
iface lo inet loopback

# Ethernet (DHCP)
auto eth0
iface eth0 inet dhcp
    # DNS para la VM
    dns-nameservers 8.8.8.8 8.8.4.4

